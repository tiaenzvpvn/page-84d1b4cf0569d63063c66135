dding-left:18px;font-size:15px}\n.band li{margin-bottom:6px}\n\n/* 客户端 */\n.clients{margin-top:8px;background:#fff;border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:8px 32px}\n.client-row{display:grid;grid-template-columns:180px 1fr auto;gap:24px;align-items:center;padding:20px 0;border-bottom:1px solid var(--slate-100)}\n.client-row:last-child{border-bottom:none}\n.client-row h3{font-size:16px;color:var(--slate-900)}\n.client-row p{font-size:14px;color:var(--slate-500)}\n.client-row .status{font-size:13px;color:var(--cyan-dark);background:var(--cyan-soft);padding:4px 12px;border-radius:999px;white-space:nowrap}\n.clients-note{margin-top:18px;font-size:14px;color:var(--slate-500);max-width:52em}\n\n/* FAQ 编号列表 */\n.faq{margin-top:8px;counter-reset:faq}\n.faq-item{counter-increment:faq;background:#fff;border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:24px 28px 24px 78px;position:relative;margin-bottom:14px}\n.faq-item::before{content:counter(faq,decimal-leading-zero);position:absolute;left:28px;top:24px;font-size:15px;font-weight:800;color:var(--cyan);letter-spacing:.04em}\n.faq-item h3{font-size:17px;margin-bottom:8px;color:var(--slate-900)}\n.faq-item p{font-size:15px;color:var(--slate-700)}\n.faq-group-title{font-size:14px;letter-spacing:.16em;color:var(--slate-500);margin:34px 0 16px}\n.faq-group-title:first-of-type{margin-top:8px}\n\n/* 页脚 */\n.foot{background:var(--slate-800);color:var(--slate-400);padding:44px 0 52px;font-size:14px}\n.foot-inner{display:flex;flex-wrap:wrap;gap:28px;justify-content:space-between;align-items:flex-start}\n.foot strong{color:#fff;font-size:17px;display:block;margin-bottom:8px}\n.foot a{color:var(--cyan)}\n.foot-nav{display:flex;flex-wrap:wrap;gap:8px 20px;max-width:340px}\n.foot-nav a{color:var(--slate-200);font-size:14px}\n.foot-small{margin-top:30px;padding-top:20px;border-top:1px solid rgba(207,216,220,.16);font-size:13px;color:var(--slate-500)}\n\n@media (max-width:900px){\n  .hero-grid{grid-template-columns:1fr;gap:34px}\n  .plan{grid-template-columns:44px 1fr;gap:18px 20px;padding:26px 24px}\n  .plan-features{grid-column:1 / -1}\n  .plan-price{grid-column:1 / -1;text-align:left;border-left:none;border-top:1px dashed var(--slate-200);padding-left:0;padding-top:16px;display:flex;flex-wrap:wrap;align-items:center;gap:14px}\n  .plan-price .year{margin-top:0}\n  .plan-price .buy{margin-top:0;margin-left:auto}\n  .steps{grid-template-columns:1fr}\n  .band{grid-template-columns:1fr;padding:26px 24px}\n  .client-row{grid-template-columns:1fr;gap:8px;padding:18px 0}\n  .client-row .status{justify-self:start}\n  .clients{padding:8px 24px}\n}\n@media (max-width:520px){\n  section{padding:48px 0}\n  .hero{padding:22px 0 48px}\n  .anchors{margin-bottom:32px}\n  .faq-item{padding:22px 20px 22px 62px}\n  .faq-item::before{left:20px}\n}\n</style><main>\n\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <nav class=\"anchors\" aria-label=\"页面内锚点\">\n        <a href=\"#plans\">套餐</a>\n        <a href=\"#howto\">使用说明</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n\n      <div class=\"hero-grid\">\n        <div>\n          <p class=\"hero-kicker\">牛马云 · 套餐与使用说明</p>\n          <h1>牛马云<span>：</span>先把价格和权益读清楚</h1>\n          <p class=\"hero-lede\">三档套餐，一张页面。流量、设备数、线路类型、支持方式逐条列出，不做模糊表述。选之前慢慢对照，选之后按步骤走。</p>\n          <div class=\"hero-quick\">\n            <div><strong>3</strong>套餐档位</div>\n            <div><strong>100GB</strong>入门月流量</div>\n            <div><strong>20</strong>团队版设备数</div>\n          </div>\n        </div>\n\n        <aside class=\"panel\" aria-label=\"套餐概览\">\n          <h2>套餐速览</h2>\n          <dl>\n            <div class=\"panel-row\">\n              <dt>基础版</dt>\n              <dd>¥15<em>/月</em></dd>\n            </div>\n            <div class=\"panel-row\">\n              <dt>旗舰版</dt>\n              <dd>¥35<em>/月</em></dd>\n            </div>\n            <div class=\"panel-row\">\n              <dt>团队版</dt>\n              <dd>¥85<em>/月</em></dd>\n            </div>\n            <div class=\"panel-row\">\n              <dt>年付</dt>\n              <dd>¥150 起<em>/年</em></dd>\n            </div>\n          </dl>\n          <p class=\"panel-note\">价格为页面标注的月付与年付口径。下单前请在结算页核对当期价格与权益，以结算页显示为准。</p>\n        </aside>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"section-no\">01</span>\n        <h2>套餐逐条展开</h2>\n      </div>\n      <p class=\"section-sub\">每一档单独一行，左侧编号，右侧价格。权益按项列出，不折叠、不省略。</p>\n\n      <div class=\"plans\">\n\n        <article class=\"plan\">\n          <div class=\"plan-idx\">1</div>\n          <div class=\"plan-name\">\n            <h3>基础版</h3>\n            <p>适合个人日常使用，起步档位。</p>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 100GB 流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <div class=\"plan-price\">\n            <span class=\"now\">¥15<small> /月</small></span>\n            <span class=\"year\">按年付 ¥150/年</span>\n            <a class=\"buy\" href=\"#faq\">了解条款</a>\n          </div>\n        </article>\n\n        <article class=\"plan featured\">\n          <div class=\"plan-idx\">2</div>\n          <div class=\"plan-name\">\n            <h3>旗舰版</h3>\n            <span class=\"tag\">推荐</span>\n            <p>流量与设备数居中，含专线类线路与优先支持。</p>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 300GB 流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <div class=\"plan-price\">\n            <span class=\"now\">¥35<small> /月</small></span>\n            <span class=\"year\">按年付 ¥350/年</span>\n            <a class=\"buy\" href=\"#faq\">了解条款</a>\n          </div>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"plan-idx\">3</div>\n          <div class=\"plan-name\">\n            <h3>团队版</h3>\n            <p>面向多人共用，含定制路由与专人对接。</p>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 1000GB 流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <div class=\"plan-price\">\n            <span class=\"now\">¥85<small> /月</small></span>\n            <span class=\"year\">按年付 ¥850/年</span>\n            <a class=\"buy\" href=\"#faq\">了解条款</a>\n          </div>\n        </article>\n\n      </div>\n\n      <p class=\"plans-foot\">三档套餐的流量、设备数与线路权益以上方列表为准。年付价格为页面标注口径，结算时请再次确认。</p>\n    </div>\n  </section>\n\n  <section id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"section-no\">02</span>\n        <h2>使用说明</h2>\n      </div>\n      <p class=\"section-sub\">四步走完：选档、开通、配置、核对。每一步只做一件事。</p>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <span class=\"n\">步骤 一</span>\n          <h3>先定档位</h3>\n          <p>按两件事选：每月流量上限，同时在线设备数。设备数按“同一时间连接”计算，不是账号下所有设备总数。</p>\n          <p>拿不准就从基础版开始，后续按月调整档位即可。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"n\">步骤 二</span>\n          <h3>完成开通</h3>\n          <p>在结算页确认所选档位、计费周期与实付金额，再提交。年付与月付的差额会在结算页单独显示。</p>\n          <p>提交后请保存订单信息，后续咨询时用它定位账号。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"n\">步骤 三</span>\n          <h3>配置客户端</h3>\n          <p>按设备选择对应客户端，填入账号提供的配置信息。不同系统的填写方式见下一页“客户端”区块。</p>\n          <p>配置完成后先做一次连通性核对，再投入日常使用。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"n\">步骤 四</span>\n          <h3>核对用量</h3>\n          <p>每月查看一次流量消耗与设备占用。接近上限时，先对照旗舰版与团队版的差额，再决定是否升档。</p>\n          <p>用量口径以账号内的显示为准。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"n\">注意</span>\n          <h3>关于线路</h3>\n          <p>基础版使用普通线路节点池；旗舰版与团队版包含专线类线路。具体可用线路以账号内实际显示为准。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"n\">注意</span>\n          <h3>关于支持</h3>\n          <p>旗舰版与团队版包含优先工单支持。提问时附上订单编号、设备系统与具体现象，处理更快。</p>\n        </article>\n      </div>\n\n      <div class=\"band\">\n        <div>\n          <h3>选档的简单判断</h3>\n          <ul>\n            <li>单人、设备少、用量中等：基础版</li>\n            <li>多设备、看流媒体、要专线类线路：旗舰版</li>\n            <li>多人共用、需要定制路由：团队版</li>\n          </ul>\n        </div>\n        <div>\n          <h3>配置前的两个提醒</h3>\n          <p>一，先确认设备数量不超过所选档位上限。二，配置信息按账号实际提供为准，不要使用来源不明的第三方配置。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"section-no\">03</span>\n        <h2>客户端与设备</h2>\n      </div>\n      <p class=\"section-sub\">按系统列出配置入口。下载以实际提供的渠道为准，页面不提供直链。</p>\n\n      <div class=\"clients\">\n        <div class=\"client-row\">\n          <h3>Windows</h3>\n          <p>桌面端配置，适合长时间在线场景。填入账号提供的配置后重启客户端再测试。</p>\n          <span class=\"status\">桌面</span>\n        </div>\n        <div class=\"client-row\">\n          <h3>macOS</h3>\n          <p>桌面端配置，安装后按提示授予必要权限，再导入配置信息。</p>\n          <span class=\"status\">桌面</span>\n        </div>\n        <div class=\"client-row\">\n          <h3>Android</h3>\n          <p>移动端配置。安装来源请以实际提供的渠道为准，避免使用来路不明的安装包。</p>\n          <span class=\"status\">移动</span>\n        </div>\n        <div class=\"client-row\">\n          <h3>iOS / iPadOS</h3>\n          <p>移动端配置。按系统提示完成添加，配置信息由账号提供。</p>\n          <span class=\"status\">移动</span>\n        </div>\n        <div class=\"client-row\">\n          <h3>路由器</h3>\n          <p>用于整屋多设备共用。团队版支持企业定制路由，路由器侧的配置方式以实际环境为准。</p>\n          <span class=\"status\">网络设备</span>\n        </div>\n      </div>\n\n      <p class=\"clients-note\">以上按系统分类，不代表已在每个平台完成兼容性验证。具体可用性与下载来源，请以账号内提供的说明为准。</p>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"section-no\">04</span>\n        <h2>常见问题</h2>\n      </div>\n      <p class=\"section-sub\">按编号逐条回答。看完还有疑问，走工单，附上订单编号。</p>\n\n      <div class=\"faq\">\n\n        <p class=\"faq-group-title\">关于套餐</p>\n\n        <article class=\"faq-item\">\n          <h3>三档套餐的主要差别是什么？</h3>\n          <p>差别在三处：每月流量（100GB / 300GB / 1000GB）、同时在线设备数（3 / 5 / 20）、线路与支持。基础版走普通线路节点池；旗舰版含全节点原生流媒体解锁与 IPLC 专线游戏加速优化；团队版再加 VIP 专属高带宽节点、企业定制路由与专属客户经理。</p>\n        </article>\n\n        <article class=\"faq-item\">\n          <h3>月付和年付怎么选？</h3>\n          <p>页面标注的年付为：基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年。如果只是试一段时间，先用月付；确定长期用再换年付。结算页显示的数字才是有约束力的价格。</p>\n        </article>\n\n        <article class=\"faq-item\">\n          <h3>“同时在线设备数”怎么算？</h3>\n          <p>指同一时刻保持连接的设备数量，不是账号下可以添加的设备总数。超出上限时，新设备可能无法连接，需要先断开一台。</p>\n        </article>\n\n        <article class=\"faq-item\">\n          <h3>流量用不完会留到下个月吗？</h3>\n          <p>页面未对流量结转作说明，请勿默认可以累计。以账号内显示的当月用量与计费说明为准。</p>\n        </article>\n\n        <article class=\"faq-item\">\n          <h3>中途可以升档或降档吗？</h3>\n          <p>可以先看旗舰版与当前档位在流量、设备数上的差额，再决定是否调整。具体调整方式与生效时间，请以账号内可操作项为准。</p>\n        </article>\n\n        <p class=\"faq-group-title\">关于使用</p>\n\n        <article class=\"faq-item\">\n          <h3>配置之后连不上，先查什么？</h3>\n          <p>按顺序排查：一，检查设备数是否已超上限；二，核对配置信息是否与账号一致；三，重启客户端后再次测试；四，换一台设备比对。仍不解决再提交工单。</p>\n        </article>\n\n        <article class=\"faq-item\">\n          <h3>流媒体解锁在哪个档位？</h3>\n          <p>基础版为“解锁基础流媒体”，旗舰版为“全节点原生流媒体解锁”。具体哪些服务可用，以实际使用时的结果为准。</p>\n        </article>\n\n        <article class=\"faq-item\">\n          <h3>为什么强调不要用第三方配置？</h3>\n          <p>来源不明的配置可能与你购买的档位不一致，也无法对应到你的账号，出问题时难以定位。始终使用账号内提供的配置信息。</p>\n        </article>\n\n        <p class=\"faq-group-title\">关于支持与订单</p>\n\n        <article class=\"faq-item\">\n          <h3>工单怎么写更容易被处理？</h3>\n          <p>写清四件事：订单编号、设备系统与版本、具体现象、已经尝试过的步骤。信息完整的工单不需要来回追问，处理更快。</p>\n        </article>\n\n        <article class=\"faq-item\">\n          <h3>团队版可以对接谁？</h3>\n          <p>团队版含专属客户经理服务，适合多人共用与需要定制路由的场景。对接方式以账号内提供的联系渠道为准。</p>\n        </article>\n\n        <article class=\"faq-item\">\n          <h3>页面上的价格是否长期有效？</h3>\n          <p>页面展示的是本文撰写时标注的价格与权益。实际下单前，请以结算页显示的金额、周期与档位权益为准；本页面不构成价格承诺。</p>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer class=\"foot\">\n  <div class=\"wrap\">\n    <div class=\"foot-inner\">\n      <div>\n        <strong>牛马云</strong>\n        <p>套餐、使用说明与常见问题集中在一页，方便对照阅读。</p>\n      </div>\n      <nav class=\"foot-nav\" aria-label=\"页脚导航\">\n        <a href=\"#plans\">套餐</a>\n        <a href=\"#howto\">使用说明</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n    <p class=\"foot-small\">页面内容为信息说明，价格与权益请以结算页及账号内显示为准。</p>\n  </div>\n</footer>",
